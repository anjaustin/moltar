#version 450

// Out-projection: out = Wout * y
// Wout is row-major [D,D], y is [D], out is [D]

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer YBuf { float y[]; };        // [D]
layout(std430, binding = 1) writeonly buffer OutBuf { float outv[]; };  // [D]
layout(std430, binding = 2) readonly buffer WoutBuf { float Wout[]; };  // [D*D]

layout(push_constant) uniform Push {
  uint D;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  uint D = pc.D;
  if (i >= D) return;

  float acc = 0.0;
  uint base = i * D;
  for (uint j = 0; j < D; j++) {
    acc += Wout[base + j] * y[j];
  }
  outv[i] = acc;
}

