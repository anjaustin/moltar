#version 450

/*
 * GPU Ternary GEMM with Native INT8 + Shift-Add
 * 
 * Key optimizations:
 * 1. INT8 activations (native storage)
 * 2. Ternary weights as 2-bit packed
 * 3. NO float multiply - just add/subtract based on trit value
 * 4. Accumulate in INT32, convert to float only at end
 * 
 * Trit encoding: 00=0, 01=+1, 10=-1, 11=0
 * 
 * For +1: sum += activation (add)
 * For -1: sum -= activation (subtract)  
 * For 0:  nothing (skip)
 *
 * This eliminates ALL multiplies in the inner loop!
 */

#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

layout(local_size_x = 64) in;  // 64 threads per workgroup

// Packed ternary weights: 4 trits per byte
layout(binding = 0) readonly buffer Weights {
    uint8_t packed_weights[];  // N * K/4 bytes
};

// INT8 activations
layout(binding = 1) readonly buffer Activations {
    int8_t activations[];  // K elements
};

// Per-row scales (FP32 for simplicity)
layout(binding = 2) readonly buffer Scales {
    float scales[];  // N elements (one scale per row)
};

// Output (FP32)
layout(binding = 3) writeonly buffer Output {
    float output_data[];  // N elements
};

// Dimensions
layout(push_constant) uniform Params {
    uint N;  // rows (output dim)
    uint K;  // cols (input dim)
};

// Shared memory for reduction
shared int32_t partial_sums[64];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    
    if (row >= N) return;
    
    // Each thread processes K/64 elements
    uint elements_per_thread = K / 64u;
    uint start_k = tid * elements_per_thread;
    
    // Row offset in packed weights (K/4 bytes per row)
    uint row_offset = row * (K / 4u);
    
    int32_t sum = 0;
    
    // Process 4 elements at a time (one packed byte = 4 trits)
    for (uint i = 0u; i < elements_per_thread; i += 4u) {
        uint k = start_k + i;
        uint byte_idx = row_offset + (k / 4u);
        uint8_t packed = packed_weights[byte_idx];
        
        // Load 4 activations
        int32_t a0 = int32_t(activations[k + 0u]);
        int32_t a1 = int32_t(activations[k + 1u]);
        int32_t a2 = int32_t(activations[k + 2u]);
        int32_t a3 = int32_t(activations[k + 3u]);
        
        // Decode and accumulate - NO MULTIPLY!
        // Trit 0: bits [1:0]
        uint t0 = uint(packed) & 3u;
        if (t0 == 1u) sum += a0;       // +1
        else if (t0 == 2u) sum -= a0;  // -1
        // else: 0 or 3, skip
        
        // Trit 1: bits [3:2]
        uint t1 = (uint(packed) >> 2u) & 3u;
        if (t1 == 1u) sum += a1;
        else if (t1 == 2u) sum -= a1;
        
        // Trit 2: bits [5:4]
        uint t2 = (uint(packed) >> 4u) & 3u;
        if (t2 == 1u) sum += a2;
        else if (t2 == 2u) sum -= a2;
        
        // Trit 3: bits [7:6]
        uint t3 = uint(packed) >> 6u;
        if (t3 == 1u) sum += a3;
        else if (t3 == 2u) sum -= a3;
    }
    
    // Store to shared memory
    partial_sums[tid] = sum;
    barrier();
    
    // Parallel reduction (64 threads -> 1 result)
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            partial_sums[tid] += partial_sums[tid + stride];
        }
        barrier();
    }
    
    // Thread 0 writes final result
    if (tid == 0u) {
        float result = float(partial_sums[0]) * scales[row];
        output_data[row] = result;
    }
}
