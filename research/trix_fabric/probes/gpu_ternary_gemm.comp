#version 450

/*
 * GPU Ternary GEMM + Spline Activation
 * 
 * This shader implements:
 * 1. Ternary weight decode (2-bit packed → {-1, 0, +1})
 * 2. Matrix-vector multiply (one row per workgroup)
 * 3. Spline activation via texture lookup
 *
 * Memory layout:
 * - Weights: 2-bit packed, 4 trits per byte, row-major
 * - Activations: fp16 input vector
 * - Scales: fp16 per-block scales (32 weights per block)
 * - Output: fp16 after spline activation
 *
 * For LFM2-350M FFN gate: N=4096, K=1024
 * - Weights: 4096 * 1024 * 0.25 = 1 MB
 * - One workgroup computes one output row
 */

layout(local_size_x = 128) in;  // 128 threads per workgroup

// Ternary weights: 2-bit packed (4 trits per byte)
layout(binding = 0) readonly buffer Weights {
    uint packed_weights[];  // K/16 uint32s per row (each uint32 = 16 trits)
};

// Input activations (fp16 stored as uint for bit manipulation)
layout(binding = 1) readonly buffer Input {
    uint input_fp16[];  // K/2 pairs of fp16
};

// Per-block scales (one fp16 scale per 32 weights)
layout(binding = 2) readonly buffer Scales {
    uint scales_fp16[];  // N * (K/32) / 2 pairs of fp16
};

// Output buffer (needs read-write for packing odd rows)
layout(binding = 3) buffer Output {
    uint output_fp16[];  // N/2 pairs of fp16
};

// Spline activation lookup table (256 entries, fp16 as uint pairs)
layout(binding = 4) readonly buffer SplineLUT {
    uint spline_lut[];  // 128 pairs of fp16
};

// Dimensions
layout(push_constant) uniform Params {
    uint N;  // Output dimension (rows)
    uint K;  // Input dimension (cols)
};

// Shared memory for partial sums
shared float partial_sums[128];

// Decode 2-bit trit to {-1, 0, +1}
int decode_trit(uint trit) {
    // Encoding: 00 = 0, 01 = +1, 10 = -1, 11 = 0
    if (trit == 1u) return 1;
    if (trit == 2u) return -1;
    return 0;
}

// Unpack fp16 from uint (lower or upper half)
float unpack_fp16_lo(uint packed) {
    return unpackHalf2x16(packed).x;
}

float unpack_fp16_hi(uint packed) {
    return unpackHalf2x16(packed).y;
}

void main() {
    uint row = gl_WorkGroupID.x;          // Which output row (0 to N-1)
    uint tid = gl_LocalInvocationID.x;    // Thread within workgroup (0 to 127)
    
    if (row >= N) return;
    
    // Each thread processes K/128 elements
    uint elements_per_thread = K / 128u;
    uint start_k = tid * elements_per_thread;
    
    float sum = 0.0;
    
    // Process weights in chunks of 16 (one uint32 = 16 trits)
    uint weights_per_row = K / 16u;  // Number of uint32s per row
    uint row_offset = row * weights_per_row;
    
    uint blocks_per_thread = elements_per_thread / 32u;  // Scale blocks per thread
    uint scale_row_offset = row * (K / 32u);
    
    for (uint chunk = 0u; chunk < elements_per_thread / 16u; chunk++) {
        uint k_base = start_k + chunk * 16u;
        uint weight_idx = row_offset + (k_base / 16u);
        uint packed = packed_weights[weight_idx];
        
        // Get scale for this block (32 weights share one scale)
        uint block_idx = k_base / 32u;
        uint scale_pair_idx = (scale_row_offset + block_idx) / 2u;
        uint scale_packed = scales_fp16[scale_pair_idx];
        float scale = (block_idx % 2u == 0u) ? 
            unpack_fp16_lo(scale_packed) : unpack_fp16_hi(scale_packed);
        
        // Process 16 trits from this uint32
        for (uint i = 0u; i < 16u; i++) {
            uint trit = (packed >> (i * 2u)) & 0x3u;
            int weight = decode_trit(trit);
            
            // Get input activation
            uint k = k_base + i;
            uint input_pair_idx = k / 2u;
            uint input_packed = input_fp16[input_pair_idx];
            float act = (k % 2u == 0u) ? 
                unpack_fp16_lo(input_packed) : unpack_fp16_hi(input_packed);
            
            // Accumulate: weight is {-1, 0, +1}, so just add/subtract/skip
            sum += scale * float(weight) * act;
        }
    }
    
    // Store partial sum to shared memory
    partial_sums[tid] = sum;
    barrier();
    
    // Parallel reduction
    for (uint stride = 64u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            partial_sums[tid] += partial_sums[tid + stride];
        }
        barrier();
    }
    
    // Thread 0 applies spline activation and writes output
    if (tid == 0u) {
        float result = partial_sums[0];
        
        // Spline activation via buffer lookup with linear interpolation
        // Map result from [-4, 4] to [0, 255]
        float idx_f = clamp(result * 32.0 + 128.0, 0.0, 255.0);
        uint idx_lo = uint(idx_f);
        uint idx_hi = min(idx_lo + 1u, 255u);
        float frac = idx_f - float(idx_lo);
        
        // Fetch two LUT values and interpolate (manual bilinear)
        float lo_val = (idx_lo % 2u == 0u) ? 
            unpack_fp16_lo(spline_lut[idx_lo / 2u]) : unpack_fp16_hi(spline_lut[idx_lo / 2u]);
        float hi_val = (idx_hi % 2u == 0u) ? 
            unpack_fp16_lo(spline_lut[idx_hi / 2u]) : unpack_fp16_hi(spline_lut[idx_hi / 2u]);
        float activated = mix(lo_val, hi_val, frac);
        
        // Pack and store output
        uint out_idx = row / 2u;
        // Note: This is simplified - real impl needs atomic for odd rows
        if (row % 2u == 0u) {
            output_fp16[out_idx] = packHalf2x16(vec2(activated, 0.0));
        } else {
            // Would need atomic OR for proper packing
            uint existing = output_fp16[out_idx];
            vec2 pair = unpackHalf2x16(existing);
            pair.y = activated;
            output_fp16[out_idx] = packHalf2x16(pair);
        }
    }
}
