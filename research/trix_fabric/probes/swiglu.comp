#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : enable

// SwiGLU activation: out[i] = SiLU(gate[i]) * up[i]
// SiLU(x) = x * sigmoid(x) = x / (1 + exp(-x))
//
// This is the hot activation path in LFM2's FFN:
//   gate = matvec(x, W_gate)   [done on CPU]
//   up   = matvec(x, W_up)     [done on CPU]
//   out  = SiLU(gate) * up     [THIS SHADER]
//   down = matvec(out, W_down) [done on CPU]

layout(local_size_x = 128) in;  // Match PowerVR subgroup size

layout(set = 0, binding = 0) buffer Gate { float gate[]; };
layout(set = 0, binding = 1) buffer Up   { float up[];   };
layout(set = 0, binding = 2) buffer Out  { float out_buf[]; };

layout(push_constant) uniform Params {
    uint n_elements;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= n_elements) return;

    float g = gate[idx];
    float u = up[idx];

    // SiLU(g) = g * sigmoid(g) = g / (1 + exp(-g))
    float silu_g = g / (1.0 + exp(-g));

    out_buf[idx] = silu_g * u;
}
